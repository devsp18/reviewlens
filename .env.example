# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model names are configurable so they can be bumped without code changes.
# gemini-3.8-flash is the newest Flash model but was returning 503 (over
# capacity) as of 2026-09-22; gemini-3.6-flash is confirmed working.
# Check https://ai.google.dev/gemini-api/docs/models for the latest.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
