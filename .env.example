# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model names are configurable so they can be bumped without code changes.
# Current recommended defaults (check https://ai.google.dev/gemini-api/docs/models for the latest):
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
