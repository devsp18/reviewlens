# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model names are configurable so they can be bumped without code changes.
# gemini-3.5-flash-lite has a much higher free-tier daily request quota than
# the full gemini-3.x-flash models (which cap around 20 requests/day free) -
# useful default for batch classification. Bump to a full Flash model if you
# have billing enabled. Check https://ai.google.dev/gemini-api/docs/models
# for the latest lineup.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
